        "bank_question_id": "bq_hs_kp_found_set_001",
        "content_html": "<p>已知集合 A={x | 1&lt;x&lt;5}，B={2,3,5,6}，求 A∩B。</p>",
        "answer_html": "<p>A∩B={2,3}。</p>",
        "analysis_html": "<p>集合 A 中元素满足 1&lt;x&lt;5，集合 B 中同时满足条件的元素是 2 和 3。</p>",
        "knowledge_point_ids": [
          "kp_hs_kp_found_set_001"
        ],
        "question_type": "填空题",
