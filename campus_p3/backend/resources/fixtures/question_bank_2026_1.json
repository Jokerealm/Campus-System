      },
      {
        "bank_question_id": "bq_hs_kp_found_set_002",
        "content_html": "<p>设 p：x&gt;2，q：x&gt;0。判断 p 是 q 的什么条件。</p>",
        "answer_html": "<p>p 是 q 的充分不必要条件。</p>",
        "analysis_html": "<p>由 x&gt;2 可推出 x&gt;0，但 x&gt;0 不能推出 x&gt;2，所以 p 是 q 的充分不必要条件。</p>",
        "knowledge_point_ids": [
          "kp_hs_kp_found_set_002"
        ],
        "question_type": "单选题",
        "difficulty": 0.55,
        "images": [],
        "audit_status": "approved"
      },
