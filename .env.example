# Campus-System local configuration.
# Copy to .env for local development. Never commit real API keys.

CAMPUS_LLM_BASE_URL=https://api.example.com/v1
CAMPUS_LLM_API_KEY=
CAMPUS_LLM_MODEL=openai-compatible
CAMPUS_LLM_TIMEOUT_SECONDS=8

# P2 calls P3 when this is set. If P3 is not running, P2 falls back to local seed fixtures.
CAMPUS_P3_BASE_URL=http://127.0.0.1:8103
CAMPUS_P3_SERVICE_ID=p2-service
CAMPUS_P3_AUTH_TOKEN=
CAMPUS_P3_TIMEOUT_SECONDS=5

# P2 local demo persistence. This keeps exams, uploaded files, diagnostics and lesson-plan metadata across restarts.
CAMPUS_P2_SQLITE_PATH=data/p2_demo.sqlite3
CAMPUS_P1_MAX_PAPER_UPLOAD_BYTES=52428800
CAMPUS_P1_MAX_SCORE_UPLOAD_BYTES=10485760
CAMPUS_P2_MAX_PAPER_UPLOAD_BYTES=52428800
CAMPUS_P2_MAX_SCORE_UPLOAD_BYTES=10485760

# Optional P2 demo access control. Keep disabled for local one-click demos.
# When enabled, standard teacher-side endpoints require X-Teacher-Id or X-Service-Id.
# If CAMPUS_P2_AUTH_TOKEN is set, requests must also send Authorization: Bearer <token>.
CAMPUS_AUTH_REQUIRED=false
CAMPUS_P2_AUTH_TOKEN=
CAMPUS_DEFAULT_TENANT_ID=demo_school
CAMPUS_DEFAULT_TEACHER_ID=teacher_demo
CAMPUS_DEFAULT_STUDENT_ID=student_demo
# Optional local account allowlist for controlled school demos.
# When CAMPUS_AUTH_REQUIRED=true and CAMPUS_IDENTITY_DIRECTORY_REQUIRED=true,
# X-Teacher-Id / X-Student-Id / X-Service-Id must exist in this JSON directory.
CAMPUS_IDENTITY_DIRECTORY_REQUIRED=false
CAMPUS_IDENTITY_DIRECTORY_PATH=

# Frontend demo identity headers. Do not put production secrets into VITE_* variables.
VITE_CAMPUS_TENANT_ID=demo_school
VITE_CAMPUS_TEACHER_ID=teacher_demo
VITE_CAMPUS_STUDENT_ID=student_demo
VITE_CAMPUS_DEMO_AUTH_TOKEN=

# P3 local demo database. PostgreSQL remains the default for docker-compose/deployment.
P3_DATABASE_ENGINE=sqlite
P3_SQLITE_PATH=data/p3_demo.sqlite3
